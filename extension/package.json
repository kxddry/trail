{
  "name": "Trail",
  "version": "1.1.1",
  "description": "Your browser sessions, visualized.",
  "main": "service-worker.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "generate-icons": "tsx src/shared/utils/generate-icons.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "e2e": "pnpm run build && playwright test",
    "e2e:ui": "pnpm run build && playwright test --ui",
    "bench:sidepanel-cold-load": "node --import tsx tests/sidepanel-cold-load.bench.ts"
  },
  "keywords": [],
  "author": "Trail",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.3",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.37",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wxt-dev/i18n": "^0.2.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "wxt": "^0.20.18",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/browser": "^10.75.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@webext-core/messaging": "^2.3.0",
    "@webext-core/proxy-service": "^2.0.1",
    "@xyflow/react": "^12.11.6",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.52.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "minisearch": "^7.2.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "p-debounce": "^5.1.1",
    "posthog-js-lite": "^4.12.1",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.12.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tinykeys": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  }
}
